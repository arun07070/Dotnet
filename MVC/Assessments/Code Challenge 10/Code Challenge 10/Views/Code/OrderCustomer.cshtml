@model Code_Challenge_10.Models.Customer

@{
    ViewBag.Title = "Customer Details";
}

<h2>Customer Details for Order ID 10248</h2>

@if (Model != null)
{
    <table class="table table-bordered">
        <tr>
            <th>Customer ID</th>
            <td>@Model.CustomerID</td>
        </tr>

        <tr>
            <th>Company Name</th>
            <td>@Model.CompanyName</td>
        </tr>

        <tr>
            <th>Contact Name</th>
            <td>@Model.ContactName</td>
        </tr>

        <tr>
            <th>Contact Title</th>
            <td>@Model.ContactTitle</td>
        </tr>

        <tr>
            <th>Country</th>
            <td>@Model.Country</td>
        </tr>
    </table>
}
else
{
    <h3>No customer found.</h3>
}